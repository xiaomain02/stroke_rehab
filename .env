# Адрес бэкенда (FastAPI)
VITE_API_URL=http://localhost:8000
# true = работать на моках, без бэкенда
VITE_MOCK=true
# Replace this with a long random value before deploying the FastAPI backend.
AUTH_SECRET=replace-with-a-long-random-secret
# SQLite file used for registered accounts. Relative paths are resolved from the backend working directory.
AUTH_DATABASE_PATH=auth.sqlite3
